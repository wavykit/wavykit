{
    "name": "wavykit/pages",
    "description": "A Laravel page registry for consistent breadcrumbs and navigation.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "WavyKit\\Pages\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WavyKit\\Pages\\PagesServiceProvider"
            ]
        }
    }
}
