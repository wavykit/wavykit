{
    "name": "wavykit/pages",
    "description": "A Laravel page registry for consistent breadcrumbs and navigation.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WavyKit\\Pages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WavyKit\\Pages\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@composer validate --strict",
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "WavyKit\\Pages\\Laravel\\PagesServiceProvider"
            ]
        }
    }
}
