{
    "name": "wavykit/navigation",
    "description": "Named Laravel menus derived from, or arranged around, WavyKit pages.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "wavykit/pages": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "WavyKit\\Navigation\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WavyKit\\Navigation\\NavigationServiceProvider"
            ]
        }
    }
}
